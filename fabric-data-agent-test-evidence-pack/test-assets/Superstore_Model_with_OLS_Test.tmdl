			annotation Synonyms = Orders, Transactions, Order Lines, Line Items, Purchases, Orders Placed, Deals, Sales Transactions, Purchase Orders, Order Details, Sales Details, Order Records, Transaction Records, Invoices, Sales Records, Order History

		table 'Project Measures'
			lineageTag: dc612dd2-998d-4ee9-b681-81662815ec02

			/// Sum of all net sales revenue after discounts. Calculated as Quantity × Unit Price × (1 - Discount Rate). Use for revenue analysis and performance tracking.
			measure 'Total Sales' = SUM ( Sales[Sales Amount] )
				formatString: $#,0
				displayFolder: 1. Sales
				lineageTag: fffa5175-b013-4591-9389-5194eb087426

				annotation Synonyms = Revenue, Net Sales, Sales Revenue, Total Revenue, Net Revenue, Sales Booked, Total Transaction Value, Net Amount, Sales Recorded, Cumulative Sales, Revenue Generated, Annual Sales, Period Sales, Sales Closed, Deal Value

			/// Total sales at full list price before any discounts applied. Shows the maximum potential revenue without promotional discounts.
			measure 'Gross Sales' = SUMX ( Sales, Sales[Quantity] * Sales[Unit Price] )
				formatString: $#,0
				displayFolder: 1. Sales
				lineageTag: 63b7e5df-1e91-4436-8193-cc6f30ad2de3

				annotation Synonyms = Gross Revenue, Pre-Discount Sales, List Sales, Pre-Promo Sales, Full Price Sales, Undiscounted Sales, Gross Transaction Value, Revenue Before Discount, Invoice Total, Gross Amount, Pre-Adjustment Sales

			/// Total dollar value of discounts given (Gross Sales - Total Sales). Indicates promotional spending and margin pressure.
			measure 'Discount Amount' = [Gross Sales] - [Total Sales]
				formatString: $#,0
				displayFolder: 1. Sales
				lineageTag: 49cf0c6f-bf38-4e05-ab8c-ba15c81895bc

				annotation Synonyms = Total Discount, Discount Value, Discount Dollar, Promo Spend, Markdown Amount, Total Discounts, Discount Spend, Promotional Spend, Rebate Amount, Promotional Amount, Discount Total

			/// Discounts as a percentage of gross sales. Reveals discount intensity and promotional pressure on pricing.
			measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Sales] )
				formatString: 0.0%
				displayFolder: 1. Sales
				lineageTag: 6c761a0b-5460-4130-b99b-e1d0b488ded5

				annotation Synonyms = Discount Rate, Discount Percentage, Promo Rate, % Discounted, Markdown %, Promotional Rate, Discount Intensity, Discount Level, Average Discount

			/// Total units sold across all orders and line items. Key metric for volume-based analysis.
			measure 'Total Quantity' = SUM ( Sales[Quantity] )
				formatString: #,0
				displayFolder: 1. Sales
				lineageTag: ac9f5140-dde3-4151-ade9-3649ea8eee74

				annotation Synonyms = Units Sold, Total Units, Quantity Ordered, Units Shipped, Volume, Item Count, Total Items, Pieces Sold, Product Count, Total Volume, Units Delivered, Cumulative Quantity

			/// Average revenue per unit sold (Total Sales / Total Quantity). Indicates effective pricing after discounts.
			measure 'Average Selling Price' = DIVIDE ( [Total Sales], [Total Quantity] )
				formatString: $#,0.00
				displayFolder: 1. Sales
				lineageTag: 9de7daa3-7a32-4b1e-ae55-750e7d9ab2d5

				annotation Synonyms = ASP, Avg Price, Per-Unit Revenue, Average Unit Price, Unit Revenue, Mean Selling Price, Price per Unit, Revenue per Unit, Average Revenue per Unit

			/// Percentage share of total sales within the current filter context. Used for market share and contribution analysis.
			measure 'Sales % of Total' = DIVIDE ( [Total Sales], CALCULATE ( [Total Sales], ALLSELECTED () ) )
				formatString: 0.0%
				displayFolder: 1. Sales
				lineageTag: ab6498b4-57b5-4b1d-82e1-9ad2a2020c31

				annotation Synonyms = % of Total Sales, Sales Share, Market Share, Revenue Share, Sales Contribution, Percentage of Total, Sales Percentage, Contribution Percentage, Share of Sales

			/// Sum of all profit amounts across orders. Core profitability metric for business performance.
			measure 'Total Profit' = SUM ( Sales[Profit Amount] )
				formatString: $#,0
				displayFolder: 2. Profit
				lineageTag: 326e13c3-9ff5-47d3-87f4-1341c0cd6491

				annotation Synonyms = Net Profit, Earnings, Bottom Line, Profit Amount, Net Income, Operating Income, Operating Profit, Gross Profit, Net Earnings, Profit Value, Total Earnings, Cumulative Profit

			/// Profit as a percentage of sales (Total Profit / Total Sales). Indicates operational efficiency and pricing power.
			measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
				formatString: 0.0%
				displayFolder: 2. Profit
				lineageTag: 4a193adf-63d7-447f-ac19-d2ecee9057f1

				annotation Synonyms = Margin %, Net Margin, Profit %, Profitability, Operating Margin %, Return on Sales %, Margin Ratio, ROS, Net Profit Margin, Profit Percentage, Operating Profitability

			/// Average profit generated per order (Total Profit / Order Count). Shows average profitability at the order level.
			measure 'Profit per Order' = DIVIDE ( [Total Profit], [Order Count] )
				formatString: $#,0.00
				displayFolder: 2. Profit
				lineageTag: ae3442e1-b188-432a-9e39-5acb85fe5820

				annotation Synonyms = Per-Order Profit, Average Order Profit, Profit per Transaction, Order Profit, Average Profit per Order, Profit per Deal, Per-Deal Profit

			/// Percentage share of total profit within the current filter context. Used for profit contribution analysis.
			measure 'Profit % of Total' = DIVIDE ( [Total Profit], CALCULATE ( [Total Profit], ALLSELECTED () ) )
				formatString: 0.0%
				displayFolder: 2. Profit
				lineageTag: 3601f442-f6c0-4054-abb4-f89fa462373f

				annotation Synonyms = % of Total Profit, Profit Share, Profit Contribution, Profit by Segment, Profit Percentage, Profit Share %, Contribution to Profit

			/// Distinct number of orders placed. Measures transaction frequency and customer activity volume.
			measure 'Order Count' = DISTINCTCOUNT ( Sales[Order ID] )
				formatString: #,0
				displayFolder: 3. Orders & Customers
				lineageTag: eeaf3c50-dce6-4d4f-b5de-2f691ee7b2f7

				annotation Synonyms = Total Orders, Number of Orders, Orders, Order Volume, Transaction Count, Distinct Orders, Order Frequency, Total Transactions, Order Instances, Deal Count, Purchase Orders

			/// Total number of line items across all orders. Indicates transaction complexity and bundling behavior.
			measure 'Order Line Count' = COUNTROWS ( Sales )
				formatString: #,0
				displayFolder: 3. Orders & Customers
				lineageTag: a661f900-0895-40e4-841a-9aec47c9a6dc

				annotation Synonyms = Line Items, Total Lines, Line Count, Transaction Lines, Order Details, Order Items, Detail Count, Line Item Count, Total Order Lines

			/// Distinct number of customers who made purchases. Measures customer acquisition and active customer base.
			measure 'Customer Count' = DISTINCTCOUNT ( Sales[Customer ID] )
				formatString: #,0
				displayFolder: 3. Orders & Customers
				lineageTag: c7390d69-b2ec-4436-b74c-e0d7f501324e

				annotation Synonyms = Active Customers, Unique Customers, Customer Base, Distinct Customers, Customer Volume, Total Customers, Customer Population, Unique Accounts, Customer Instances, Buyer Count

			/// Average revenue per order (Total Sales / Order Count). Key metric for understanding customer spending patterns.
			measure 'Average Order Value' = DIVIDE ( [Total Sales], [Order Count] )
				formatString: $#,0.00
				displayFolder: 3. Orders & Customers
				lineageTag: ad457292-88bf-4d90-91df-2921a9cae639

				annotation Synonyms = AOV, Avg Order Value, Per-Order Revenue, Average Transaction Value, Order Size, Average Revenue per Order, Mean Order Value, Typical Order Value, Average Customer Spend

			/// Average number of units purchased per order (Total Quantity / Order Count). Shows typical order size in units.
			measure 'Units per Order' = DIVIDE ( [Total Quantity], [Order Count] )
				formatString: #,0.0
				displayFolder: 3. Orders & Customers
				lineageTag: 33779e3a-b2b0-413a-a265-60814ca073e1

				annotation Synonyms = Average Qty per Order, Items per Order, Units per Transaction, Order Qty, Average Units per Order, Avg Items per Order, Mean Items per Order

			/// Average revenue per customer (Total Sales / Customer Count). Measures customer lifetime value contribution.
			measure 'Sales per Customer' = DIVIDE ( [Total Sales], [Customer Count] )
				formatString: $#,0.00
				displayFolder: 3. Orders & Customers
				lineageTag: d66d040f-98a5-4b8c-a804-5aac334327b9

				annotation Synonyms = Customer Revenue, Per-Customer Revenue, Customer Lifetime Value, Average Customer Sales, Revenue per Customer, CLV, Customer Spend, Avg Customer Value

			/// Total number of line items that were returned (Is Returned = 1). Measures return volume and potential quality issues.
			measure 'Returned Lines' = CALCULATE ( COUNTROWS ( Sales ), Sales[Is Returned] = 1 )
				formatString: #,0
				displayFolder: 4. Returns
				lineageTag: 1f65903d-4a10-47db-bc2a-33d6594f468c

				annotation Synonyms = Returns, Returned Items, Return Volume, Defective Items, Damaged Items, Return Count, Returned Units, RMA Count, Number of Returns, Return Instances

			/// Percentage of line items that were returned. Indicator of customer satisfaction and product quality.
			measure 'Return Rate %' = DIVIDE ( [Returned Lines], [Order Line Count] )
				formatString: 0.0%
				displayFolder: 4. Returns
				lineageTag: 083631ac-faff-4297-ac8f-23ca477a7686

				annotation Synonyms = Return %, Defect Rate, Return Percentage, Refund Rate, Return Frequency, Return Ratio, Churn Rate, Defect Percentage, Quality Issue Rate

			/// Total sales value of returned items. Shows revenue impact of returns and customer dissatisfaction.
			measure 'Returned Sales' = CALCULATE ( [Total Sales], Sales[Is Returned] = 1 )
				formatString: $#,0
				displayFolder: 4. Returns
				lineageTag: c88822cb-60a9-4b6e-849e-c644b40e1abc

				annotation Synonyms = Return Revenue, Returns Value, Refund Amount, Returned Amount, Return Sales, Return Dollars, Refund Revenue, Loss to Returns

			/// Returned sales as a percentage of total sales. Indicates return frequency and financial impact.
			measure 'Returned Sales %' = DIVIDE ( [Returned Sales], [Total Sales] )
				formatString: 0.0%
				displayFolder: 4. Returns
				lineageTag: b6c3991a-eb1c-4513-99a2-a503aab3b33e

				annotation Synonyms = Return %, Return Percentage, % Returns, Refund Rate, Return Impact %, Loss Rate, Return Loss %

			/// Total sales analyzed from the ship date perspective rather than order date. Uses the inactive Ship Date relationship for fulfillment-based reporting.
			measure 'Sales by Ship Date' = CALCULATE ( [Total Sales], USERELATIONSHIP ( Sales[Ship Date Key], Date[Date Key] ) )
				formatString: $#,0
				displayFolder: 5. Shipping
				lineageTag: b29848e9-9d6f-4db9-beed-ff568821c834

				annotation Synonyms = Fulfillment Sales, Ship Date Revenue, Delivery Date Sales, Fulfillment Revenue, Shipment Sales, Delivery Revenue, Fulfillment Basis Sales

			/// Average number of days between order placement and shipment for items that were shipped. Measures fulfillment speed.
			measure 'Average Days to Ship' =
					AVERAGEX (
					    FILTER ( Sales, NOT ISBLANK ( Sales[Ship Date Key] ) ),
					    VAR o = Sales[Order Date Key]
					    VAR s = Sales[Ship Date Key]
					    RETURN
					        DATEDIFF (
					            DATE ( INT ( o / 10000 ), MOD ( INT ( o / 100 ), 100 ), MOD ( o, 100 ) ),
					            DATE ( INT ( s / 10000 ), MOD ( INT ( s / 100 ), 100 ), MOD ( s, 100 ) ),
					            DAY
					        )
					)
				formatString: 0.0
				displayFolder: 5. Shipping
				lineageTag: 0fb46a1b-b388-4471-8f9d-4fa5898a9896

				annotation Synonyms = Average Ship Days, Fulfillment Time, Order to Ship Time, Transit Duration, Days to Fulfill, Processing Days, Fulfillment Days, Lead Time, Avg Shipping Days

			/// Percentage of shipped items delivered within the shipping mode's standard transit days. Key performance indicator for supply chain.
			measure 'On-Time Shipping %' =
					VAR Shipped =
					    FILTER ( Sales, NOT ISBLANK ( Sales[Ship Date Key] ) )
					VAR OnTime =
					    FILTER (
					        Shipped,
					        VAR o = Sales[Order Date Key]
					        VAR s = Sales[Ship Date Key]
					        VAR Days =
					            DATEDIFF (
					                DATE ( INT ( o / 10000 ), MOD ( INT ( o / 100 ), 100 ), MOD ( o, 100 ) ),
					                DATE ( INT ( s / 10000 ), MOD ( INT ( s / 100 ), 100 ), MOD ( s, 100 ) ),
					                DAY
					            )
					        RETURN
					            Days <= RELATED ( 'Shipping Mode'[Standard Transit Days] )
					    )
					RETURN
					    DIVIDE ( COUNTROWS ( OnTime ), COUNTROWS ( Shipped ) )
				formatString: 0.0%
				displayFolder: 5. Shipping
				lineageTag: 7427059d-0428-4db1-99e9-810f0355dd3e

				annotation Synonyms = On-Time Delivery %, Fulfillment Rate, SLA %, Delivery Performance, Service Level Achievement, On-Time Performance, Delivery Rate, On-Time %, Fulfillment %, On-Time Percentage

			/// Year-to-date sales from January 1 to the current date. Used for progress tracking and annual goal comparison.
			measure 'Sales YTD' = TOTALYTD ( [Total Sales], Date[Date] )
				formatString: $#,0
				displayFolder: 6. Time Intelligence
				lineageTag: f6cb89aa-e4ac-456f-8467-759139200c00

				annotation Synonyms = Year-to-Date Sales, YTD Sales, SYTD, Year-to-Date Revenue, Cumulative Sales, Sales-to-Date, Running Total Sales, YTD Revenue, Year-to-Now Sales

			/// Sales for the same period in the prior year. Baseline for year-over-year performance comparison.
			measure 'Sales PY' = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( Date[Date] ) )
				formatString: $#,0
				displayFolder: 6. Time Intelligence
				lineageTag: 68f02b79-f2f6-4e92-bd30-5a38ce0668db

				annotation Synonyms = Prior Year Sales, Last Year Sales, Previous Year Sales, Year-Ago Sales, YoY Baseline, Comparative Sales, Prior Period Sales, Same Period Last Year

			/// Absolute dollar change in sales compared to the prior year (Current Year - Prior Year Sales). Shows growth in dollars.
			measure 'Sales YoY Change' =
					VAR PY = [Sales PY]
					RETURN IF ( NOT ISBLANK ( PY ), [Total Sales] - PY )
				formatString: $#,0;-$#,0
				displayFolder: 6. Time Intelligence
				lineageTag: e0b2268a-eb34-4735-959a-2bac49e78be8

				annotation Synonyms = Year-over-Year Change, YoY Change, Annual Growth, Sales Increase, YoY Difference, Period Growth, Absolute Change, Year-on-Year Change

			/// Percentage growth in sales compared to the prior year. Measures sales growth rate for performance tracking.
			measure 'Sales YoY %' =
					VAR PY = [Sales PY]
					RETURN IF ( NOT ISBLANK ( PY ), DIVIDE ( [Total Sales] - PY, PY ) )
				formatString: 0.0%;-0.0%
				displayFolder: 6. Time Intelligence
				lineageTag: e7b55715-6c68-4238-a40c-8cfc41db63fe

				annotation Synonyms = Year-over-Year Growth, YoY Growth, Year-over-Year %, Growth Rate, Annual Growth %, YoY %, Period-on-Period Growth, Percentage Growth, Growth %, Year Comparison %

			/// Year-to-date profit from January 1 to the current date. Tracks profit accumulation toward annual targets.
			measure 'Profit YTD' = TOTALYTD ( [Total Profit], Date[Date] )
				formatString: $#,0
				displayFolder: 6. Time Intelligence
				lineageTag: c073e4c0-ccd4-42f9-b3a8-6ee116b5910e

				annotation Synonyms = Year-to-Date Profit, YTD Profit, Cumulative Profit, Profit-to-Date, Year-to-Date Earnings, YTD Earnings, Running Profit Total, Profit-to-Now

			/// Profit for the same period in the prior year. Baseline for year-over-year profit comparison.
			measure 'Profit PY' = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( Date[Date] ) )
				formatString: $#,0
				displayFolder: 6. Time Intelligence
				lineageTag: 54effdf1-4c2f-4265-b895-01170e92e485

				annotation Synonyms = Prior Year Profit, Last Year Profit, Previous Year Profit, Year-Ago Profit, Comparative Profit, Prior Period Profit, Same Period Last Year Profit

			/// Percentage growth in profit compared to the prior year. Measures profitability improvement rate.
			measure 'Profit YoY %' =
					VAR PY = [Profit PY]
					RETURN IF ( NOT ISBLANK ( PY ), DIVIDE ( [Total Profit] - PY, PY ) )
				formatString: 0.0%;-0.0%
				displayFolder: 6. Time Intelligence
				lineageTag: 9e635d4b-e910-4b2d-a9d6-d436a0ab152e

				annotation Synonyms = Year-over-Year Profit Growth, YoY Profit %, Profit Growth Rate, Annual Profit Growth %, Profit Growth %, Period-on-Period Profit %, YoY Profit Change %

