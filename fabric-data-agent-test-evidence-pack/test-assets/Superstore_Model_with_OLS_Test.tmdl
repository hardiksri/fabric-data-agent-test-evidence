nth_date_hierarchy_has_date_year_month_year":{"Binding":{"ConceptualEntity":"Date"},"State":"Generated","Roles":{"date.year_month.date_hierarchy":{"Target":{"Entity":"date.year_month.date_hierarchy"}},"date.year_month.year":{"Target":{"Entity":"date.year_month.year"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"date.year_month.date_hierarchy"},"Object":{"Role":"date.year_month.year"}},"State":"Generated","Weight":0.99,"ID":"year_month_date_hierarchies_have_year_month_years"}]},"date_year_month_date_hierarchy_has_date_year_month_quarter":{"Binding":{"ConceptualEntity":"Date"},"State":"Generated","Roles":{"date.year_month.date_hierarchy":{"Target":{"Entity":"date.year_month.date_hierarchy"}},"date.year_month.quarter":{"Target":{"Entity":"date.year_month.quarter"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"date.year_month.date_hierarchy"},"Object":{"Role":"date.year_month.quarter"}},"State":"Generated","Weight":0.99,"ID":"year_month_date_hierarchies_have_year_month_quarters"}]},"date_year_month_date_hierarchy_has_date_year_month_month":{"Binding":{"ConceptualEntity":"Date"},"State":"Generated","Roles":{"date.year_month.date_hierarchy":{"Target":{"Entity":"date.year_month.date_hierarchy"}},"date.year_month.month":{"Target":{"Entity":"date.year_month.month"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"date.year_month.date_hierarchy"},"Object":{"Role":"date.year_month.month"}},"State":"Generated","Weight":0.99,"ID":"year_month_date_hierarchies_have_year_month_months"}]},"date_year_month_date_hierarchy_has_date_year_month_day":{"Binding":{"ConceptualEntity":"Date"},"State":"Generated","Roles":{"date.year_month.date_hierarchy":{"Target":{"Entity":"date.year_month.date_hierarchy"}},"date.year_month.day":{"Target":{"Entity":"date.year_month.day"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"date.year_month.date_hierarchy"},"Object":{"Role":"date.year_month.day"}},"State":"Generated","Weight":0.99,"ID":"year_month_date_hierarchies_have_year_month_days"}]},"product_launch_date_has_date_hierarchy":{"Binding":{"ConceptualEntity":"Product"},"State":"Generated","Roles":{"product.launch_date":{"Target":{"Entity":"product.launch_date"}},"product.launch_date.date_hierarchy":{"Target":{"Entity":"product.launch_date.date_hierarchy"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"product.launch_date"},"Object":{"Role":"product.launch_date.date_hierarchy"}},"State":"Generated","Weight":0.99,"ID":"launch_dates_have_launch_date_hierarchies"}]},"product_launch_date_date_hierarchy_has_product_launch_date_year":{"Binding":{"ConceptualEntity":"Product"},"State":"Generated","Roles":{"product.launch_date.date_hierarchy":{"Target":{"Entity":"product.launch_date.date_hierarchy"}},"product.launch_date.year":{"Target":{"Entity":"product.launch_date.year"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"product.launch_date.date_hierarchy"},"Object":{"Role":"product.launch_date.year"}},"State":"Generated","Weight":0.99,"ID":"launch_date_hierarchies_have_launch_years"}]},"product_launch_date_date_hierarchy_has_product_launch_date_quarter":{"Binding":{"ConceptualEntity":"Product"},"State":"Generated","Roles":{"product.launch_date.date_hierarchy":{"Target":{"Entity":"product.launch_date.date_hierarchy"}},"product.launch_date.quarter":{"Target":{"Entity":"product.launch_date.quarter"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"product.launch_date.date_hierarchy"},"Object":{"Role":"product.launch_date.quarter"}},"State":"Generated","Weight":0.99,"ID":"launch_date_hierarchies_have_launch_quarters"}]},"product_launch_date_date_hierarchy_has_product_launch_date_month":{"Binding":{"ConceptualEntity":"Product"},"State":"Generated","Roles":{"product.launch_date.date_hierarchy":{"Target":{"Entity":"product.launch_date.date_hierarchy"}},"product.launch_date.month":{"Target":{"Entity":"product.launch_date.month"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"product.launch_date.date_hierarchy"},"Object":{"Role":"product.launch_date.month"}},"State":"Generated","Weight":0.99,"ID":"launch_date_hierarchies_have_launch_months"}]},"product_launch_date_date_hierarchy_has_product_launch_date_day":{"Binding":{"ConceptualEntity":"Product"},"State":"Generated","Roles":{"product.launch_date.date_hierarchy":{"Target":{"Entity":"product.launch_date.date_hierarchy"}},"product.launch_date.day":{"Target":{"Entity":"product.launch_date.day"}}},"Phrasings":[{"Attribute":{"Subject":{"Role":"product.launch_date.date_hierarchy"},"Object":{"Role":"product.launch_date.day"}},"State":"Generated","Weight":0.99,"ID":"launch_date_hierarchies_have_launch_days"}]}},"Agents":{"Internal":{"Version":"1.1.0"}},"CustomInstructions":"# SUPERSTORE SEMANTIC MODEL — AI INSTRUCTIONS\n\n## Purpose\nGovern business interpretation, object selection, measures, relationships, date logic, filtering, and query generation for Superstore analytics. Presentation, visuals, tone, summaries, follow-ups, and Code Interpreter behavior belong to the Data Agent.\n\n## Global Rules\n1. Use governed measures from `Project Measures` whenever available. Never rebuild an existing KPI from raw columns.\n2. Use columns for filtering, grouping, slicing, and detail; not as substitutes for governed KPIs.\n3. Do not aggregate IDs, keys, postal codes, coordinates, fiscal fields, or technical columns.\n4. Ignore hidden, technical, helper, local-date, test, or implementation objects unless required internally by a governed measure.\n5. Respect model relationships and security. Do not infer alternate joins from similar column names.\n6. Explicit user filters and periods always override defaults.\n7. If no matching data exists, return no data. Do not silently fall back to another period or population.\n\n## KPI Discovery\nWhen asked for available KPIs, list governed KPIs only. Do not include raw/helper/technical/hidden objects and do not return values unless requested.\n\nPrimary KPIs:\n- Total Sales\n- Total Profit\n- Profit Margin %\n- Total Quantity\n- Order Count\n- Customer Count\n- Return Rate %\n- On-Time Shipping %\n\nSecondary KPIs:\n- Gross Sales\n- Discount Amount\n- Discount %\n- Average Selling Price\n- Sales % of Total\n- Profit per Order\n- Profit % of Total\n- Order Line Count\n- Average Order Value\n- Units per Order\n- Sales per Customer\n- Returned Lines\n- Returned Sales\n- Returned Sales %\n- Sales by Ship Date\n- Average Days to Ship\n- Sales YTD\n- Sales PY\n- Sales YoY Change\n- Sales YoY %\n- Profit YTD\n- Profit PY\n- Profit YoY %\n\n# Sales and Profit\nThe authoritative transaction fact is `Sales`, at one row per order line item.\n\nMap intent to governed measures:\n- Sales, Revenue, Net Sales, Net Revenue → `[Total Sales]`\n- Gross Sales, Pre-discount Sales → `[Gross Sales]`\n- Discount value → `[Discount Amount]`\n- Discount rate/percentage → `[Discount %]`\n- Units, Quantity, Volume → `[Total Quantity]`\n- Profit, Earnings → `[Total Profit]`\n- Margin, Profit Margin, Profitability % → `[Profit Margin %]`\n- Sales contribution/share → `[Sales % of Total]`\n- Profit contribution/share → `[Profit % of Total]`\n\nRules:\n- `Total Sales` is net sales after discounts.\n- `Gross Sales` is pre-discount sales.\n- Do not use Product[List Price] as realized revenue.\n- Do not average row-level margin or discount percentages when governed measures exist.\n\n# Orders and Customers\nKeep these concepts separate:\n- Orders → `[Order Count]` (distinct Order ID)\n- Order/transaction lines → `[Order Line Count]`\n- Customers who purchased → `[Customer Count]`\n- Units → `[Total Quantity]`\n\nIf “transactions” clearly means customer orders, use `[Order Count]`. If the user explicitly says transaction rows, lines, or items, use `[Order Line Count]`. Clarify only when the distinction materially changes the result.\n\nUse `Customer` for Customer Name, Customer Segment, Company Name, Loyalty Tier, and Customer Since Date. Do not use Customer ID in business-facing results unless explicitly requested.\n\n# Product\nUse `Product` for product analysis.\nPreferred hierarchy:\nCategory → Sub-Category → Product Name\n\nUse product attributes for grouping/filtering and governed measures for performance.\n\nExamples:\n- Sales by Category → Product[Category] + `[Total Sales]`\n- Profit by Product → Product[Product Name] + `[Total Profit]`\n\nDo not use Product[List Price] as actual sales.\n\n# Geography\nUse `Location` for geography.\nPreferred hierarchy:\nCountry → Region → State → City → Postal Code\n\nUse Country, Region, State, City, Postal Code, and Market Size for grouping/filtering. Latitude and Longitude are location attributes, not business measures.\n\n# Returns\nUse:\n- Returns / Returned Lines → `[Returned Lines]`\n- Return Rate → `[Return Rate %]`\n- Returned Revenue / Returned Sales → `[Returned Sales]`\n- Returned Sales % → `[Returned Sales %]`\n\n`Returned Lines` counts returned sales lines, not distinct returned orders.\nDo not treat Return Rate % and Returned Sales % as the same KPI.\n\n# Shipping and Fulfillment\nUse `Shipping Mode` plus governed shipping measures:\n- Sales by shipment/ship date → `[Sales by Ship Date]`\n- Average fulfillment duration → `[Average Days to Ship]`\n- On-time shipping/service level → `[On-Time Shipping %]`\n\nDo not recreate On-Time Shipping logic from raw dates and transit days.\n\n# Time Rules\nDefault sales-analysis date = Order Date.\n\nTherefore:\n- Sales in 2025 → `[Total Sales]` using Order Date\n- Profit last month → Order Date context\n- Orders by quarter → Order Date context\n- Sales trend / YoY Sales → Order Date context\n\nShip Date is a separate date role and is inactive by design. When the user explicitly asks for Ship Date, Shipped Date, Shipment Date, Fulfillment Date, or Sales Shipped, use `[Sales by Ship Date]`.\n\nExamples:\n- “Sales in March” → `[Total Sales]`\n- “Sales shipped in March” → `[Sales by Ship Date]`\n\nCalendar vs fiscal:\n- Year, quarter, month, and YTD mean calendar unless “Fiscal” or “FY” is explicit.\n- Fiscal Year and Fiscal Quarter requests use Date fiscal attributes.\n- `[Sales YTD]` and `[Profit YTD]` are calendar YTD. Do not describe them as fiscal YTD.\n\nPrior-year / YoY:\n- Prior Year Sales → `[Sales PY]`\n- Sales YoY dollar change → `[Sales YoY Change]`\n- Sales YoY growth % → `[Sales YoY %]`\n- Prior Year Profit → `[Profit PY]`\n- Profit YoY growth % → `[Profit YoY %]`\n\nExplicit period always wins. If the requested period has no data, do not substitute another period.\n\n# Rankings and Comparisons\nFor Top/Bottom N:\n1. Use the requested business dimension.\n2. Rank by the requested governed measure.\n3. Preserve all explicit filters and period context.\n\nFor comparisons:\n- use the same governed measure on all sides\n- preserve the same filters\n- retain the comparison dimension\n- do not aggregate comparison members into one result\n\n# Ambiguity Defaults\nUse these defaults when intent is clear:\n- Sales / Revenue → Total Sales\n- Profit → Total Profit\n- Margin → Profit Margin %\n- Orders → Order Count\n- Customers → Customer Count\n- Units → Total Quantity\n- Returns → Returned Lines\n- Return Rate → Return Rate %\n- YTD → calendar YTD\n- normal date analysis → Order Date\n- ship-date analysis → Sales by Ship Date\n\nAsk one clarification only when ambiguity materially changes the generated query.\n\n# Restrictions\nNever:\n- rebuild governed KPIs from raw columns\n- aggregate IDs, keys, postal code, latitude, longitude, fiscal fields, or hierarchy levels\n- treat Order Line Count as Order Count\n- treat Quantity as Order Count\n- treat Returned Lines as returned-order count\n- treat Return Rate % as Returned Sales %\n- treat Gross Sales as Total Sales\n- treat Profit as Profit Margin %\n- use List Price as actual revenue\n- use Ship Date for normal sales analysis\n- use Order Date when ship-date analysis is explicitly requested\n- interpret calendar YTD as fiscal YTD\n- invent unsupported KPIs such as inventory, budget, forecast, target, procurement spend, employee performance, or payment status\n- infer unsupported joins or override model security"}
				contentType: json

		role 'DataAgent_OLS_Test'
			modelPermission: read

			tablePermission Customer
				columnPermission 'Company Name'
					metadataPermission: none

		annotation __PBI_TimeIntelligenceEnabled = 1

		annotation PBI_QueryOrder = ["Customer","Date","Location","Product","Shipping Mode","Sales","Project Measures"]

		annotation PBI_ProTooling = ["MCP-PBIModeling","TMDLView_Desktop","CopilotTooling"]

