				mode: import
				source =
						let
						    Source = Value.NativeQuery(DatabricksMultiCloud.Catalogs("dbc-d00e7d51-8fd9.cloud.databricks.com", "/sql/1.0/warehouses/7fcb7d09b7a3d277", [Catalog="fin_prod", Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation="2.0", MetricViewBiCompatibilityMode=null]){[Name="fin_prod",Kind="Database"]}[Data], "select * from superstore.fin_prod.fact_sales", null, [EnableFolding=true]),
